# 将这些参数合并进现有 .env，不要覆盖已配置的原媒体路径和应用端口。
# 专用下载根的宿主绝对路径；Linux 示例 /srv/nas/downloads，Windows 示例 E:/NAS/downloads。
DOWNLOAD_PATH=/srv/nas/downloads
# qB 配置和恢复数据的宿主绝对路径；不与应用 SQLite 或媒体目录重叠。
QBT_CONFIG_PATH=/srv/nas/qb-config
# 与 WebUI 中设置的固定密码一致的本地文件；只读挂给栖库，不提交到 Git。
QBT_PASSWORD_FILE=./.runtime/downloads/qb-password
# 已有引擎的 WebAPI 基地址；采用可选官方引擎时无需修改。
DOWNLOAD_QB_URL=http://qbittorrent:8080
# qB 看到的同一下载根；只有外接实例的容器路径不同时才需要调整。
DOWNLOAD_ENGINE_ROOT=/downloads
# qB WebUI 用户名，与栖库登录名相互独立。
DOWNLOAD_QB_USERNAME=admin
# 下载卷保留空间，单位 GiB，独立于应用封面缓存预算。
DOWNLOAD_MIN_FREE_GB=2
# 固定官方镜像的版本和多架构摘要，不使用 latest；更新前单独验证。
QBT_IMAGE=qbittorrentofficial/qbittorrent-nox:5.2.4-1@sha256:92bfd78d731e254ba64f62b77b0696add6447a33642ee5feda106a26b285aa7f
# 阅读官方法律告知后填写 confirm；空值会阻止可选引擎启动。
QBT_LEGAL_NOTICE=
# 下载进程宿主 UID，专用配置与下载目录必须允许其写入。
QBT_UID=1000
# 下载进程宿主 GID，按目标 NAS 的实际权限配置。
QBT_GID=1000
# BT peer TCP/UDP 端口，不是 WebUI 管理端口。
QBT_PEER_PORT=6881
# 首次设置 WebUI 的宿主回环端口，设置后撤销 setup 覆盖。
QBT_SETUP_PORT=18080
# 下载器日志时区，不影响应用内部 UTC 存储。
QBT_TIMEZONE=Asia/Shanghai
