# 宿主机 Web 端口，浏览器访问 http://NAS地址:此端口。
WEB_PORT=8090
# NAS 上已有媒体的绝对目录；应用内显示为 /media。Windows 可写 E:/Media。
MEDIA_PATH=./media
# 定期目录对账间隔，单位分钟。
SCAN_INTERVAL_MINUTES=60
# 可重建封面缓存上限，单位 MiB。
CACHE_MAX_MB=1024
# 生成缓存前预留的可用空间，单位 MiB。
MIN_FREE_MB=512
# 后台扫描/增强任务并发数，低配置设备使用 1。
WORKERS=1
# HTTPS 反向代理时设 true；本地 HTTP 访问保持 false。
COOKIE_SECURE=false
