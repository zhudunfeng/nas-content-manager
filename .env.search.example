# 将本文件参数合并进已有 .env，保留原媒体、下载卷与端口配置。
# 是否启用可选搜种；关闭后不连接索引服务，既有媒体和下载任务继续可用。
TORRENT_SEARCH_ENABLED=true
# 来源 JSON 的宿主路径；包含 API Key，不要提交到Git，应用1000:1000身份需能读取。
TORRENT_SEARCH_SOURCES_FILE=./.runtime/search/sources.json
# 可选 Jackett 的持久配置目录，事先创建并给予下方UID/GID写权限。
JACKETT_CONFIG_PATH=/srv/nas/jackett-config
# LinuxServer维护的固定版本及amd64/arm64摘要；升级前重新验证，不使用latest。
JACKETT_IMAGE=ghcr.io/linuxserver/jackett:v0.24.3065-ls36@sha256:31b58c6acfae963dbb334ffd1b721fbefebed498a3df872f058d1e5544f8b02d
# Jackett进程宿主UID，按NAS的实际权限调整。
JACKETT_UID=1000
# Jackett进程宿主GID，按NAS的实际权限调整。
JACKETT_GID=1000
# 管理页面只绑定NAS回环地址；远程配置请使用SSH隧道，不开放公网。
JACKETT_SETUP_PORT=19117
# 索引服务日志使用的时区，不改变应用UTC存储。
JACKETT_TIMEZONE=Asia/Shanghai
