# Windows 桌面专用示例：复制到栖库.exe 同级并命名为 .env；不要覆盖已有配置。
# 优先级：命令行参数 > 进程环境变量 > 此文件 > 已保存配置 > 默认值。
# 修改后从托盘退出栖库，再重新启动；程序内重新检测不会重新读取此文件。
# 本文件只支持 NAS_ 参数；每个参数的格式、范围与原有环境变量一致。

# 本机获取方式：managed 托管随包 worker，disabled 停用，external 使用外接服务。
# 需要启用本机视频/漫画获取时取消下一行注释；Docker 模式不能使用 managed。
# NAS_DESKTOP_COLLECTION_MODE=managed

# 视频插件开关：true 启用，false 停用；Windows x64托管模式缺依赖时会联网自动初始化。
# NAS_COLLECTION_WORKER_UAV_ENABLED=true
# 漫画插件开关：true 启用，false 停用；Windows x64托管模式缺依赖时会联网自动初始化。
# NAS_COLLECTION_WORKER_JMCOMIC_ENABLED=true

# 视频插件的可信 Python 绝对路径；通常保持注释以使用随包或自动初始化的运行时。
# 显式配置后由管理员维护依赖，路径错误也不会自动安装或回退。
# NAS_COLLECTION_WORKER_UAV_PYTHON='E:\可信运行时\uav\python.exe'
# 漫画插件的可信 Python 绝对路径；通常保持注释以使用随包或自动初始化的运行时。
# 显式配置后由管理员维护依赖，路径错误也不会自动安装或回退。
# NAS_COLLECTION_WORKER_JMCOMIC_PYTHON='E:\可信运行时\jmcomic\python.exe'

# 获取单任务最大字节数；示例为 20 GiB，范围与 worker 环境配置相同。
# NAS_COLLECTION_WORKER_MAX_BYTES=21474836480
# 获取单任务最大文件数。
# NAS_COLLECTION_WORKER_MAX_FILES=5000
# 获取服务要求的剩余空间，单位 MiB。
# NAS_COLLECTION_WORKER_MIN_FREE_MB=512
# 获取服务同时执行的最大任务数（1–4）。
# NAS_COLLECTION_WORKER_MAX_CONCURRENT=1

# 原生业务数据库和缓存目录；留在注释状态时沿用保存配置或程序旁默认目录。
# NAS_DATA_DIR='E:\栖库数据\data'
# 授权媒体根，多个 Windows 目录用分号分隔；不会自动迁移媒体。
# NAS_MEDIA_ROOTS='E:\影视;F:\漫画'
# 桌面回环监听地址；只能使用 127.0.0.1:端口，端口可用时保持配置值。
# NAS_ADDR=127.0.0.1:8090
# 应用后台扫描与增强任务并发数（1–4），与获取服务并发分别配置。
# NAS_WORKERS=1
# 全库定期对账间隔，单位分钟。
# NAS_SCAN_INTERVAL_MINUTES=60
# 可重建封面缓存上限，单位 MiB。
# NAS_CACHE_MAX_MB=1024
# 生成衍生物前预留的剩余空间，单位 MiB。
# NAS_MIN_FREE_MB=512

# 以下配置同样可使用既有 NAS_ 环境参数；外接 worker/BT 凭据请保存在专用文件中。
# 托管模式的监听、状态、令牌、工具和 runtime manifest 路径由启动器固定，不能在此覆盖。
# 本文件不做变量展开或反斜杠转义；路径可用单/双引号，值中 # 用引号包裹。
