# 一键初始化需先部署私有助手；浏览器不能安装Docker或添加宿主挂载。
# 用法：复制到.env.engines，改专用根后 docker compose --env-file .env.engines -f compose.yaml -f compose.engines.yaml up -d --build。

# Docker宿主绝对专用根，首次必须为空或只含本安装受管目录；不要填写媒体根。
ENGINE_HOST_ROOT=/srv/nas/bt
# 独立bridge真实名称，必须与助手参数和Compose网络名称一致；需允许出站。
ENGINE_NETWORK=nas_engine_bridge
# 下载进程UID，专用目录自动创建时归属此用户；请按NAS实际权限设置。
ENGINE_UID=1000
# 下载进程和应用读取组，默认应用GID1000；不使用chmod777。
ENGINE_GID=1000
# 下载器BT TCP/UDP固定监听端口，不能与宿主其他服务冲突。
QBT_PEER_PORT=6881
# Jackett仅宿主回环配置端口；从远程经SSH转发访问并设置管理密码。
JACKETT_SETUP_PORT=19117
# 现有媒体只读宿主路径，助手和引擎不会挂载此路径。
MEDIA_PATH=./media
# 主应用网页端口。
WEB_PORT=8090
# 下载任务独立磁盘预留GiB，达到门槛时暂停受管载荷。
DOWNLOAD_MIN_FREE_GB=2
